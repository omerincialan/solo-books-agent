# --- Meta Model API (https://dev.meta.ai) ---
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The assistant's number, e.g. +16505551234
TWILIO_PHONE_NUMBER=
# Exact webhook URL set in Twilio ("A message comes in"), used to verify Twilio's signature
PUBLIC_URL=http://YOUR-SERVER/sms

# --- The owner of the books (only this number can use the assistant) ---
OWNER_PHONE_NUMBER=
OWNER_NAME=Dana
# tree_service, mechanic or tennis_coach (see solobooks/trades.py)
TRADE=tree_service
TIMEZONE=America/Los_Angeles

# --- Google Sheet (share it as Editor with the service account) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=google_service_account.json

# IRS standard mileage rate in dollars per mile (2025: 0.70)
MILEAGE_RATE=0.70

# --- Invoices ---
BUSINESS_NAME=Dana's Tree Care
BUSINESS_CONTACT=(650) 555-0100 · dana@example.com
CURRENCY=usd
# Stripe test mode key (Developers -> API keys), sk_test_...
STRIPE_SECRET_KEY=
# Optional: signing secret of a webhook endpoint for /stripe/webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
